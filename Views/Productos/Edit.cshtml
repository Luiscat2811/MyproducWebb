@model MyproducWeb.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header text-white p-4 text-center" style="background: linear-gradient(135deg, #f6d365 0%, #fda085 100%) !important;">
                    <h2 class="fw-bold m-0"><i class="bi bi-pencil-square me-2"></i>Modificar Producto</h2>
                </div>
                <div class="card-body p-5 bg-white">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="ProductoId" />

                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">Nombre del Producto</label>
                                <input asp-for="Nombre" class="form-control form-control-lg rounded-3" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Descripción</label>
                                <textarea asp-for="Descripcion" class="form-control rounded-3" rows="3"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">$</span>
                                    <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-lg border-start-0" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Stock Disponible</label>
                                <input asp-for="Stock" type="number" class="form-control form-control-lg rounded-3" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Categoría</label>
                                <select asp-for="CategoriaId" class="form-select form-select-lg rounded-3"
                                        asp-items="@(new SelectList(ViewBag.Categorias, "CategoriaId", "Nombre"))" required>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Volver Atrás</a>
                            <button type="submit" class="btn btn-warning text-white btn-lg px-5 fw-bold shadow" style="background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); border: none;">
                                <i class="bi bi-arrow-clockwise me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>